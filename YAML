version: "3.9"

services:
  blue-app:
    build: .
    container_name: blue-app
    networks:
      - bluegreen

  green-app:
    build: .
    container_name: green-app
    networks:
      - bluegreen

  blue-green-nginx:
    image: nginx:alpine
    container_name: blue-green-nginx
    ports:
      - "5000:80"
    volumes:
      - ./nginx/default.conf:/etc/nginx/conf.d/default.conf
    depends_on:
      - blue-app
      - green-app
    networks:
      - bluegreen

  jenkins-server:
    image: jenkins/jenkins:lts
    container_name: jenkins-server
    ports:
      - "8080:8080"
      - "50000:50000"
    volumes:
      - jenkins_home:/var/jenkins_home
      - /var/run/docker.sock:/var/run/docker.sock
    networks:
      - bluegreen

networks:
  bluegreen:

volumes:
  jenkins_home: