version: "3.9"

services:

  blue:
    image: blue-green-app:v1
    container_name: blue-app
    ports:
      - "8081:80"

  green:
    image: blue-green-app:v1
    container_name: green-app
    ports:
      - "8082:80"

  nginx:
    image: nginx:alpine
    container_name: traffic-controller
    ports:
      - "8080:80"
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro
    depends_on:
      - blue
      - green